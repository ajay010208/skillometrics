[TEMPLATE]
# ============================================================================
# SkilloMetrics — environment template
# Copy to .env (monorepo root) for local dev. NEVER commit the real .env.
# On hosting platforms (Render/Railway/Vercel/Fly), set these in the
# dashboard's Environment settings instead of a file.
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
# Local dev (zero setup):   file:./dev.db  (keep schema provider = "sqlite")
# Production (Supabase/Neon/RDS): flip provider first →  npm run db:postgres
#   then set DATABASE_URL to the Postgres pooler connection string, e.g.
#   postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
#   and apply schema in prod with:  npm run db:migrate:deploy
DATABASE_URL="file:./dev.db"

# ── AI provider (optional) ──────────────────────────────────────────────────
# If set, the FastAPI AI service uses a real LLM. If absent, deterministic
# fallbacks are used (the app works fully without these).
# OpenAI-compatible (OpenAI, Groq, OpenRouter, Ollama...):
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
# Or Gemini instead:
# AI_PROVIDER="gemini"
# AI_API_KEY="your-gemini-key"
# AI_MODEL="gemini-1.5-flash"

# ── Supabase auth (optional; omit for built-in demo personas) ───────────────
# When set, login uses real OAuth (Google / GitHub / LinkedIn). When absent the
# app uses one-click demo personas — perfect for judges/demos.
# Server-side token exchange (apps/api):
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Client-side OAuth (same project keys, VITE_ prefix so the web app reads them):
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Frontend origin for the OAuth redirect URL. Production: set to the deployed
# frontend, e.g. https://your-app.vercel.app (must also be registered in
# Supabase → URL Configuration → Redirect URLs). Falls back to the first
# ALLOWED_ORIGINS entry, then http://localhost:5173.
WEB_ORIGIN=""

# ── Service URLs (same-machine defaults; override when deployed apart) ─────
# API → AI service (used by apps/api to call the AI service):
AI_SERVICE_URL="http://localhost:8000"
# AI service → API (for its outbound calls; must include the /api path):
API_SERVICE_URL="http://localhost:4000/api"
# Web → API base for the built app when served statically (leave empty in dev:
# the Vite dev proxy forwards /api to the API). In production, set to your
# public API origin, e.g. https://skillometrics-api.onrender.com
VITE_API_BASE_URL=""
# Vite dev-server proxy target (defaults to http://localhost:4000):
API_TARGET="http://localhost:4000"

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API and AI service.
# Local dev default below; in production add your frontend origin, e.g.
# ALLOWED_ORIGINS="https://skillometrics.vercel.app,https://your-custom-domain.com"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5002"

# ── Ports (local dev; hosting platforms inject PORT themselves) ─────────────
API_PORT=4000
AI_PORT=8000
WEB_PORT=5173
# Production uvicorn worker count for the AI service (optional, default 1):
# AI_WORKERS=2
