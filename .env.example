# ── Database ────────────────────────────────────────────────────────────────
# Default: local SQLite (zero setup). For Supabase Postgres:
#   1) npm run db:postgres
#   2) set DATABASE_URL to your Supabase connection string (pooler URI)
#   3) npm run db:push && npm run db:seed
DATABASE_URL="file:./dev.db"

# ── AI provider (optional) ─────────────────────────────────────────────────
# If set, FastAPI uses a real LLM. If absent, deterministic fallbacks are used.
# OpenAI-compatible (OpenAI, Groq, OpenRouter, Ollama...):
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
# Or Gemini:
# AI_PROVIDER="gemini"
# AI_API_KEY="your-gemini-key"
# AI_MODEL="gemini-1.5-flash"

# ── Supabase (optional; omit for demo auth) ────────────────────────────────
# When set, login uses real OAuth (Google / GitHub / LinkedIn). When absent the
# app uses built-in one-click demo personas — perfect for judges.
# Server-side token exchange:
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Client-side OAuth (same project keys, VITE_ prefix so the web app can read them):
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ── Ports ───────────────────────────────────────────────────────────────────
API_PORT=4000
AI_PORT=8000
WEB_PORT=5173
